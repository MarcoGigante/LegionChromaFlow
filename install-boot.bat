@echo off
rem OPTIONAL: lights the keyboard as soon as Windows starts (before sign-in). Asks for administrator rights once.
net session >nul 2>&1
if %errorlevel% neq 0 (
  echo Requesting administrator rights...
  powershell -NoProfile -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
  exit /b
)
cd /d "%~dp0"
powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0install-boot.ps1"
pause
